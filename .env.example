# LOCAL DEVELOPMENT: leave DATABASE_URL empty to use PGlite.
# VERCEL: mandatory pooled PostgreSQL URL (Neon or Supabase transaction pooler).
# Obtain from the provider; preserve required TLS options. Never NEXT_PUBLIC_.
DATABASE_URL=
# Production should set true; Vercel always requires DATABASE_URL regardless.
REQUIRE_EXTERNAL_DATABASE=false
# Local-only database path. Never use a local filesystem database on Vercel.
LOCAL_DATABASE_PATH=.local/database
# LOCAL: http://localhost:3000. VERCEL: https://your-project.vercel.app
# If omitted on Vercel, VERCEL_URL supplies the current deployment HTTPS origin.
APP_URL=http://localhost:3000
# Server-only AI credential; name must stay AI_API_KEY.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1
# Optional USD per million tokens; blank disables estimated cost display.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
# Resend: required for live password reset email delivery. Verify sender domain.
EMAIL_API_KEY=
EMAIL_FROM=
# DEVELOPMENT/LOCAL TEST ONLY. Ignored on Vercel; do not set in Vercel.
DEV_MAIL_OUTBOX=false
DEV_MAIL_OUTBOX_PATH=.local/mail-outbox
# CLI ONLY: temporary secret for npm run user:create (minimum 12 characters).
# Do not configure on Vercel or keep in source control.
BOOTSTRAP_PASSWORD=
# VERCEL, VERCEL_URL and NODE_ENV are injected by the platform: do not set manually.
